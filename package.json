{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest --run --reporter dot",
    "safe-batch": "node scripts/safe-duplicate-batch-run.mjs",
    "safe-batch:rehearse": "node scripts/safe-duplicate-batch-run.mjs --execute --yes --rerun",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "validate": "npm run typecheck && npm run typecheck:api && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.4.0",
    "@tanstack/react-query-devtools": "^5.4.0",
    "@tanstack/react-table": "^8.21.3",
    "buffer": "^6.0.3",
    "clsx": "2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "22.1.0",
    "supabase": "^1.153.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "4.1.4"
  }
}
