# Prevent committing node_modules
node_modules/
node_modules
dist
.agents/
.env
.env.local
github_pat_*
.gstack/
*.png
# ...but assets the app and the deployed HTML shell actually need must ship.
# public/logo.png is the favicon fallback; a blanket *.png silently kept it out
# of the repo, which is how the live site ended up with no logo.
!assets/*.png
!public/*.png
/*.js
