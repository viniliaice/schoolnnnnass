# Dedicated Supabase Auth identity; create it for the connector with app_metadata.role=fingerprint_connector
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key
CONNECTOR_EMAIL=fingerprint-connector@your-school.example
CONNECTOR_PASSWORD=USE_A_LONG_UNIQUE_PASSWORD
# Narrow ERP API bearer token; exact match to server-side FINGERPRINT_CONNECTOR_TOKEN
ERP_API_URL=https://YOUR_ERP.vercel.app
CONNECTOR_TOKEN=USE_A_LONG_RANDOM_SECRET
# Must match server-side ZK_DEVICE_SERIAL exactly. Never put the device key here.
ZK_DEVICE_SERIAL=SET_THE_VERIFIED_K40_SERIAL
# Connector-specific local timeout parameters. Device IP/port are set only on the server.
ZK_TIMEOUT_MS=15000
ZK_DEVICE_INPORT=0
