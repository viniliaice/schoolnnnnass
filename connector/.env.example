# Connector auth: dedicated Supabase Auth account with app_metadata.role=fingerprint_connector
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key
CONNECTOR_EMAIL=fingerprint-connector@your-school.example
CONNECTOR_PASSWORD=USE_A_LONG_UNIQUE_PASSWORD
# Narrow ERP API credential shared with Vercel FINGERPRINT_CONNECTOR_TOKEN; never a Supabase key
ERP_API_URL=https://YOUR_ERP.vercel.app
CONNECTOR_TOKEN=USE_A_LONG_RANDOM_SECRET
# Device config from approved server/local settings; DO NOT assume communication key is zero
ZK_DEVICE_SERIAL=2807990625055
ZK_DEVICE_IP=192.168.1.201
ZK_DEVICE_PORT=4370
ZK_DEVICE_COMM_KEY=REQUIRED_AFTER_PHYSICAL_VERIFICATION
# Only set true if an authorized technician physically verified K40 key=0 AND approved bypass.
# zkteco-js 1.7.2 has no comm-key API; adapter otherwise refuses to connect.
ZK_COMM_KEY_ZERO_CONFIRMED=false
ZK_TIMEOUT_MS=15000
